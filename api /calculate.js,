
module.exports = async function handler(req, res) {
  // Allow POST requests only.
  if (req.method !== "POST") {
    res.setHeader("Allow", "POST");
    return res.status(405).json({
      success: false,
      error: "Please submit birth details using POST."
    });
  }

  try {
    const { birthDate, birthTime, birthPlace } = req.body || {};

    if (
      typeof birthDate !== "string" ||
      !/^\d{4}-\d{2}-\d{2}$/.test(birthDate) ||
      typeof birthTime !== "string" ||
      !/^([01]\d|2[0-3]):[0-5]\d$/.test(birthTime) ||
      typeof birthPlace !== "string" ||
      birthPlace.trim().length < 2
    ) {
      return res.status(400).json({
        success: false,
        error: "Enter a valid birth date, time, and birthplace."
      });
    }

    const apiKey = process.env.NAVAMSHA_API_KEY;

    if (!apiKey) {
      return res.status(500).json({
        success: false,
        error: "The astrology API key is not configured."
      });
    }

    /*
     * The provider's exact endpoint, authentication header,
     * and request fields must be confirmed before enabling
     * the real API request.
     */
    return res.status(501).json({
      success: false,
      error:
        "Birth details validated. The Navamsha API request format must be confirmed before calculation."
    });
  } catch (error) {
    console.error(
      "Sai Nakshatra calculation error:",
      error.message
    );

    return res.status(500).json({
      success: false,
      error: "Unable to process the birth details."
    });
  }
};


    
